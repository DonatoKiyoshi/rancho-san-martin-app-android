#!/bin/sh

##############################################################################
# Gradle start up script for POSIX generated by the Gradle wrapper plugin.
# NOTA: el binario gradle-wrapper.jar no se incluyó en este paquete (el
# entorno que generó el proyecto no tiene acceso a services.gradle.org).
# Al abrir esta carpeta en Android Studio, el IDE ofrecerá regenerarlo
# automáticamente, o puedes correr `gradle wrapper --gradle-version 8.7`
# con un Gradle instalado localmente. Ver README.md, sección "Primeros pasos".
##############################################################################

DIR="$(cd "$(dirname "$0")" && pwd)"
exec gradle "$@" --project-dir "$DIR"
