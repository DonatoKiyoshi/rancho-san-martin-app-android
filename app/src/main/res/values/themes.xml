<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.RanchoApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/rancho_primary</item>
        <item name="android:windowBackground">@color/rancho_background</item>
    </style>

    <!--
        Tema de arranque (splash) mostrado mientras carga Room/AppContainer.
        Usa el mismo icono/color de marca que el launcher para que la
        transicion a la primera pantalla se sienta continua.
    -->
    <style name="Theme.RanchoApp.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.RanchoApp</item>
    </style>
</resources>
